# ---- Core pipeline (required) ----

# Gemini, used for script analysis and visual prompt writing
CHAT_API_KEY=paste_your_gemini_api_key_here
IMAGE_API_KEY=paste_your_gemini_api_key_here
TEXT_MODEL=gemini-3.1-flash-lite

# Image generation. "fal" is the default and recommended provider:
# ~$0.0017 per image, and Gemini's free tier grants zero image quota.
IMAGE_PROVIDER=fal
FAL_KEY=paste_your_fal_api_key_here
FAL_MODEL=fal-ai/nano-banana

# Only used when IMAGE_PROVIDER=gemini (requires billing enabled)
IMAGE_MODEL=gemini-3.1-flash-image

# Voiceover and subtitles
TTS_VOICE=en-US-BrianMultilingualNeural
TTS_RATE=+8%
WHISPER_MODEL=base

# Output
OUTPUT_DIR=projects


# ---- YouTube automation (optional) ----

YOUTUBE_CLIENT_SECRETS_FILE=youtube_client_secret.json
VIDIQ_API_KEY=paste_your_vidiq_api_key_here

CHANNEL_NICHE=Hidden Mechanics
CHANNEL_TARGET_AUDIENCE=Curious general audience
UPLOAD_SCHEDULE=2x per week

# Optional: ElevenLabs for premium TTS
ELEVENLABS_API_KEY=optional_for_better_voices

# Optional: Debugging
DEBUG=false
LOG_LEVEL=INFO
